# Local prototype defaults to the existing JSON repository.
PERSISTENCE_DRIVER=json
DATA_FILE=backend/data.json
BACKUP_DIR=backend/backups

# Required for staff login. Use long, unrelated values outside local testing.
STAFF_ACCESS_CODE=replace-with-a-private-staff-code
SESSION_SECRET=replace-with-at-least-32-random-characters

# Browser origins permitted to call the API. Comma-separate any staging or production staff app origins.
# Local development defaults to localhost:4175 and 127.0.0.1:4175 when this is unset.
CORS_ALLOWED_ORIGINS=https://staff.example.com
MAX_REQUEST_BODY_BYTES=1048576
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_MS=900000

# Backend-only Supabase configuration for staging/production.
# Never prefix the secret with VITE_ and never place it in frontend files.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=sb_secret_replace_me

# Real staging contract tests use separate names so production is never targeted accidentally.
SUPABASE_TEST_URL=https://your-staging-project-ref.supabase.co
SUPABASE_TEST_SECRET_KEY=sb_secret_replace_me
